# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (Default SQLite for standalone local, or PostgreSQL for Docker)
DATABASE_URL=sqlite:///./sql_app.db

# Qdrant URL (Empty for embedded local storage, or http://localhost:6333)
QDRANT_URL=http://localhost:6333
QDRANT_LOCAL_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=pdf_chunks

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-m3

# RAG Configuration
TOP_K=5
SIMILARITY_THRESHOLD=0.35
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
