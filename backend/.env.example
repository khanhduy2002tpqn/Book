# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL
# Default SQLite for local standalone development:
DATABASE_URL=sqlite:///./sql_app.db
# PostgreSQL configuration (e.g. for Docker or production):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_pdf_reader

# Qdrant Vector Database
# Optional Qdrant URL (e.g. http://localhost:6333 or docker container).
# If left empty or if server is unreachable, local embedded Qdrant storage is used automatically!
QDRANT_URL=http://localhost:6333
QDRANT_LOCAL_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=pdf_chunks

# Embedding Model (BAAI/bge-m3 or local lightweight fallback)
EMBEDDING_MODEL=BAAI/bge-m3

# RAG Settings
TOP_K=5
SIMILARITY_THRESHOLD=0.35

# Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Security / CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
